# NewsForNerds Configuration
# Copy to .env and fill in values. All values shown are defaults unless noted.
# Environment variables override .env file values.

# --- Server ---
# LISTEN_ADDR=:8000
# DB_PATH=db.sqlite3
# LOG_FILE=logs/newsfornerds.log
# LOG_LEVEL=info  # debug, info, warn, error
# CANONICAL_DOMAIN=          # if set, redirects all other hosts to this domain

# --- Trust settings ---
# TRUST_EXEDEV_HEADERS=0     # set to 1 ONLY when every request arrives through
#                            # the exe.dev proxy. Makes X-ExeDev-UserID identify
#                            # the user. Off by default: a client that reaches
#                            # the server directly could otherwise send the
#                            # header and act as any user.
# TRUSTED_PROXIES=private    # which direct peers may set X-Forwarded-Proto/Host/For:
#                            # private (loopback + private ranges), all, none,
#                            # or a comma-separated list of IPs/CIDRs
# RATE_LIMIT_PER_MIN=300     # per-client requests a minute to the proxy, feed
#                            # and favicon endpoints; 0 disables
# PROXY_INSECURE_TLS=0       # set to 1 to let iframe widgets load sites with
#                            # invalid certificates
# FEED_PROXY_ALLOW_PRIVATE=0 # set to 1 to let a page's feed proxy be on a
#                            # private or loopback address (self-hosted LAN proxy)

# --- Google OAuth (required for login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Feed Settings ---
# FEED_REFRESH_INTERVAL=1     # minutes between refresh cycles
# FEED_STALE_MINUTES=5        # minutes before a feed is stale
# FEED_ERROR_BACKOFF=30       # minutes before retrying errored feeds
# FEED_MAX_ITEMS=300          # max items stored per feed
# FEED_MAX_PER_CYCLE=5        # max feeds refreshed per cycle
# FEED_FETCH_TIMEOUT=30       # seconds for HTTP requests
# FEED_MAX_FEEDS=5000         # most feed URLs the cache will hold
# FEED_IDLE_DAYS=14           # stop refreshing feeds nobody has opened for this long

# --- Session & Cookies ---
# SESSION_DURATION_DAYS=30    # session cookie lifetime
# VISITOR_DURATION_DAYS=365   # visitor cookie lifetime

# --- Default Colors ---
# DEFAULT_BG_COLOR=#1a1a2e         # page background
# DEFAULT_WIDGET_BG=#16213e        # widget background
# DEFAULT_WIDGET_TEXT=#ffffff       # widget text
# DEFAULT_WIDGET_HEADER=#0f3460    # widget header

# --- Cleanup ---
# VISITED_LINK_MAX_DAYS=30   # days to keep visited link records
